diff a/config/patches.toml b/config/patches.toml	(rejected hunks)
@@ -19,6 +19,31 @@ gain_db = 0.0
 [melody]
 mode = "auto"
 
+# Performance Adapter normalizes source-MIDI velocity semantics before the
+# sampler. Constant-like tracks are canonicalized to one nominal playing
+# intensity; genuinely dynamic tracks keep their contour but are recentered and
+# robustly scaled into the instrument's safe performance range. Track loudness
+# remains the job of patch gain_db / the mixer, not raw MIDI velocity.
+[performance]
+enabled = true
+constant_spread_max = 4.0
+low_percentile = 0.10
+high_percentile = 0.90
+max_expand_ratio = 1.5
+
+# First calibrated profiles are deliberately limited to the two instruments for
+# which the source corpus already showed clear cross-MIDI velocity-scale drift.
+# Add more instruments here only after their sampler operating range is audited.
+[performance.instruments.electric_bass]
+velocity_min = 50
+velocity_nominal = 72
+velocity_max = 85
+
+[performance.instruments.string_ensemble]
+velocity_min = 40
+velocity_nominal = 62
+velocity_max = 78
+
 [libraries.salamander]
 root = "AccurateSalamenderGrandPiano"
 
