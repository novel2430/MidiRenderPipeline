# Midi Render Pipeline patch registry.
# Paths are relative to this config file unless a library/plugin path is absolute.

[paths]
instruments = "../resources/instruments"
fx = "../resources/fx"
lv2 = "../resources/fx/lv2"
tools = "../resources/tools"

[libraries.salamander]
root = "AccurateSalamenderGrandPiano"

[libraries.mdm_acoustic]
root = "MDM Acoustic Guitar v1.0 WAV"

[libraries.growlybass]
root = "Growlybass"

[libraries.sm_drums]
root = "SM_Drums"

[libraries.generaluser_gs]
root = "GeneralUser-GS"

[libraries.giant_soundfonts]
root = "GiantSoundFonts"

[libraries.ui_standard_guitar]
root = "UI_Standard_Guitar"

[libraries.vpo]
root = "Virtual-Playing-Orchestra3"

[libraries.fsbs_clean]
root = "EGuitarFSBS-clean SFZ+FLAC-20260807"

[libraries.fsbs_jazz]
root = "EGuitarFSBS-jazz SFZ+FLAC-20260807"

[libraries.fsbs_drive1]
root = "EGuitarFSBS-dist1 SFZ+FLAC-20220911"

[libraries.fsbs_drive2]
root = "EGuitarFSBS-dist2 SFZ+FLAC-20220911"

[patches.acoustic_piano]
library = "salamander"
sfz = "sfz_daw/Accurate-SalamanderGrandPiano_flat.Recommended.sfz"
gain_db = 0.0

[patches.acoustic_guitar]
library = "mdm_acoustic"
sfz = "MDMAG Sustain Pick F.sfz"
gain_db = 0.0

[patches.electric_bass]
library = "growlybass"
sfz = "growlybass_clean.sfz"
gain_db = -1.0
effects = ["gxsvt"]

[patches.drums]
library = "sm_drums"
sfz = "Programs/SM_Drums_kit.sfz"
gain_db = 8.0

# UI Standard Guitar's VSOP program uses velocity-oriented articulation
# switching, which is a better default for arbitrary MIDI than its keyswitch
# programs. Both electric-guitar patches use this same DI/sample source; their
# tone is defined by the effect chains below.
[patches.electric_guitar_clean]
library = "ui_standard_guitar"
sfz = "Programs/01-Standard Guitar KSOP.sfz"
gain_db = 6.0
effects = ["blueamp_clean", "ultracab_clean"]

[patches.electric_guitar_drive]
library = "ui_standard_guitar"
sfz = "Programs/01-Standard Guitar KSOP.sfz"
gain_db = -10.0
effects = ["clubdrive", "guvnor_drive", "plexi_drive", "ultracab_drive"]

# VPO patches below intentionally use simple sustain/open/hit programs rather
# than keyswitch or mod-wheel variants. The input corpus is not authored for
# VPO-specific articulation control, so note/velocity-only playback is the safe
# automatic-rendering default.
[patches.string_ensemble]
library = "vpo"
sfz = "Virtual-Playing-Orchestra3/Strings/all-strings-SEC-sustain-panned.sfz"
gain_db = 0.0

[patches.choir]
library = "vpo"
sfz = "Virtual-Playing-Orchestra3/Vocals/choir-MIXED-sustain.sfz"
gain_db = 0.0

[patches.flute]
library = "vpo"
sfz = "Virtual-Playing-Orchestra3/Woodwinds/flute-SOLO-sustain.sfz"
gain_db = 0.0

[patches.solo_violin]
library = "vpo"
sfz = "Virtual-Playing-Orchestra3/Strings/1st-violin-SOLO-sustain.sfz"
gain_db = 0.0

[patches.solo_viola]
library = "vpo"
sfz = "Virtual-Playing-Orchestra3/Strings/viola-SOLO-sustain.sfz"
gain_db = 0.0

[patches.harp]
library = "vpo"
sfz = "Virtual-Playing-Orchestra3/Strings/harp-sustain.sfz"
gain_db = 0.0

[patches.timpani]
library = "vpo"
sfz = "Virtual-Playing-Orchestra3/Percussion/timpani-hit.sfz"
gain_db = 0.0

[patches.vibraphone]
library = "vpo"
sfz = "Virtual-Playing-Orchestra3/Percussion/vibraphone-open.sfz"
gain_db = 0.0

[patches.brass]
library = "vpo"
sfz = "Virtual-Playing-Orchestra3/Brass/all-brass-SEC-sustain.sfz"
gain_db = 0.0

[patches.horn]
library = "vpo"
sfz = "Virtual-Playing-Orchestra3/Brass/french-horn-SOLO-sustain.sfz"
gain_db = 0.0

# Bass now uses the same native Lilv/lv2apply path as the guitar effects.
# GxSVT contains its own cabinet stage, so CABSWITCH stays enabled rather than
# adding a separate UltraCab after the bass amp.
[effects.gxsvt]
backend = "lv2apply"
tool = "lv2apply"
bundle = "gx_ampegsvt.lv2"
plugin_uri = "http://guitarix.sourceforge.net/plugins/gx_ampegsvt_#_ampegsvt_"
input_channels = 1

[effects.gxsvt.params]
BYPASS = 1.0
BASS = 0.55
MIDDLE = 0.50
TREBLE = 0.30
VOLUME = 0.20
# LV2 enum numeric values: LOWSWITCH OFF=1, MIDSWITCH 800Hz=1,
# HIGHSWITCH OFF=0, CABSWITCH ON=1.
LOWSWITCH = 1
MIDSWITCH = 1
HIGHSWITCH = 0
CABSWITCH = 1

# Generic pop-clean baseline selected for the UI Standard Guitar DI source.
[effects.blueamp_clean]
backend = "lv2apply"
tool = "lv2apply"
bundle = "gx_blueamp.lv2"
plugin_uri = "http://guitarix.sourceforge.net/plugins/gx_blueamp_#_blueamp_"
input_channels = 1

[effects.blueamp_clean.params]
BYPASS = 1.0
MASTER = 0.50
TONE = 0.40
VOLUME = 0.40


[effects.ultracab_clean]
backend = "lv2apply"
tool = "lv2apply"
bundle = "gx_ultracab.lv2"
plugin_uri = "http://guitarix.sourceforge.net/plugins/gx_ultracab_#_ultracab_"
input_channels = 2

[effects.ultracab_clean.params]
BYPASS = 0.0
GAIN = 0.30
MIDS = 0.30
PUNCH = 0.30
RESONANCE = 0.45
SIZE = 0.55
TOP = 0.20

# Generic pop/rock drive baseline. Keep the overdrive moderate; Plexi and the
# cabinet complete the tone rather than asking the pedal to provide all gain.
[effects.clubdrive]
backend = "lv2apply"
tool = "lv2apply"
bundle = "gx_clubdrive.lv2"
plugin_uri = "http://guitarix.sourceforge.net/plugins/gx_clubdrive_#_clubdrive_"
input_channels = 1

[effects.clubdrive.params]
BYPASS = 1.0
DRIVE = 0.00
VOLUME = 1.0
V1 = 0.0

[effects.plexi_drive]
backend = "lv2apply"
tool = "lv2apply"
bundle = "gx_plexi.lv2"
plugin_uri = "http://guitarix.sourceforge.net/plugins/gx_plexi_#_plexi_"
input_channels = 1

[effects.plexi_drive.params]
BYPASS = 1.0
BASS = 0.30
MASTER = 0.40
MID = 0.45
PRESENSE = 0.60
TREBLE = 0.80
VOLUME = 0.25

[effects.ultracab_drive]
backend = "lv2apply"
tool = "lv2apply"
bundle = "gx_ultracab.lv2"
plugin_uri = "http://guitarix.sourceforge.net/plugins/gx_ultracab_#_ultracab_"
input_channels = 2

[effects.ultracab_drive.params]
BYPASS = 0.0
GAIN = 0.30
MIDS = 0.30
PUNCH = 0.30
RESONANCE = 0.45
SIZE = 0.55
TOP = 0.55

[effects.tube_distortion]
backend = "lv2apply"
tool = "lv2apply"
bundle = "gx_TubeDistortion.lv2"
plugin_uri = "http://guitarix.sourceforge.net/plugins/gx_TubeDistortion_#_TubeDistortion_"
input_channels = 1

[effects.tube_distortion.params]
BYPASS = 1.0
INPUT = 1.0
OUTPUT = 0.50

[effects.liquid_drive]
backend = "lv2apply"
tool = "lv2apply"
bundle = "gx_liquiddrive.lv2"
plugin_uri = "http://guitarix.sourceforge.net/plugins/gx_liquiddrive_#_liquiddrive_"
input_channels = 1

[effects.liquid_drive.params]
BYPASS = 1.0
DRIVE = 1.0
LEVEL = -10.0

[effects.guvnor_drive]
backend = "lv2apply"
tool = "lv2apply"
bundle = "gx_guvnor.lv2"
plugin_uri = "http://guitarix.sourceforge.net/plugins/gx_guvnor_#_guvnor_"
input_channels = 1

[effects.guvnor_drive.params]
GAIN = 0.90
LEVEL = 0.50
BASS = 0.35
MID = 0.55
TREBLE = 0.70
